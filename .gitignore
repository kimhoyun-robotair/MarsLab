# Track runtime files, user documentation, and the project page.
/*
!/.gitignore
!/.gitmodules
!/CONFIGURATION_GUIDE.md
!/pyproject.toml
!/README.md
!/assets/
!/configs/
!/docs/
!/launch/
!/marslab/

# Keep rover assets and atmosphere references; scenes are external downloads.
/assets/*
!/assets/m2020-urdf-models/
!/assets/mars_sky/
!/assets/robots/
!/assets/atmosphere/
/assets/scene/

# Keep the runtime configuration and both ROS companion files.
/configs/*
!/configs/config.yaml
/launch/*
!/launch/rover_state_publisher.launch.py
!/launch/companion_urdf.py

# Keep runtime Python modules and the Isaac Python launcher.
/marslab/**
!/marslab/**/
!/marslab/**/*.py
!/marslab/isaac_python.sh

# Ignore local instructions, environments, caches, and credentials.
AGENTS.md
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.vscode/
.idea/
.env
.env.*
*.key
*.pem
credentials.json
secrets.json
.DS_Store
Thumbs.db
*.swp
*.swo
*.swn
*~
