# Keep runtime inputs, source, and installation/user documentation.
/*
!/.gitignore
!/.gitmodules
!/CONFIGURATION_GUIDE.md
!/pyproject.toml
!/README.md
!/assets/
!/configs/
!/launch/
!/marslab/

# Retain rover and sky assets; scene packages remain external downloads.
/assets/*
!/assets/m2020-urdf-models/
!/assets/mars_sky/
!/assets/robots/
/assets/scene/

# The simulator consumes one configuration and one ROS companion launch.
/configs/*
!/configs/config.yaml
/launch/*
!/launch/rover_state_publisher.launch.py

# Keep runtime Python modules and the Isaac Python launcher.
/marslab/**
!/marslab/**/
!/marslab/**/*.py
!/marslab/isaac_python.sh

# Keep Project Page Module
!/site/

# Exclude local state inside retained directories as well.
AGENTS.md
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.vscode/
.idea/
.env
.env.*
*.key
*.pem
credentials.json
secrets.json
.DS_Store
Thumbs.db
*.swp
*.swo
*.swn
*~
