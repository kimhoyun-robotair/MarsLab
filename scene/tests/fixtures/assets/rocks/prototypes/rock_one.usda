#usda 1.0
(
    defaultPrim = "RockOne"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "RockOne"
{
    def Mesh "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [3, 3, 3, 3]
        int[] faceVertexIndices = [0, 2, 1, 0, 1, 3, 0, 3, 2, 1, 2, 3]
        point3f[] points = [(-0.5, -0.5, 0), (0.5, -0.5, 0), (0, 0.5, 0), (0, 0, 0.75)]
        rel material:binding = </RockOne/Looks/RockMaterial>
    }

    def Mesh "Collision" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [3, 3, 3, 3]
        int[] faceVertexIndices = [0, 2, 1, 0, 1, 3, 0, 3, 2, 1, 2, 3]
        point3f[] points = [(-0.5, -0.5, 0), (0.5, -0.5, 0), (0, 0.5, 0), (0, 0, 0.75)]
        uniform bool physics:collisionEnabled = 1
    }

    def Scope "Looks"
    {
        def Material "RockMaterial"
        {
            token outputs:surface.connect = </RockOne/Looks/RockShader.outputs:surface>
        }

        def Shader "RockShader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </RockOne/Looks/RockTexture.outputs:rgb>
            token outputs:surface
        }

        def Shader "RockTexture"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @../textures/rock.ppm@
            float3 outputs:rgb
        }
    }
}
