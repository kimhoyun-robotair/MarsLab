---
layout: null
permalink: /search.json
---
{%- assign documents = site.pages | where: 'searchable', true | sort: 'title' -%}
[
{%- for document in documents -%}
  {%- comment -%}
  Some pages have not rendered yet. Replace Liquid URL expressions with a
  harmless Markdown link target before extracting their visible text.
  {%- endcomment -%}
  {%- assign chunks = document.content | split: '{{' -%}
  {%- capture searchable_content -%}
    {%- for chunk in chunks -%}
      {%- if forloop.first -%}{{ chunk }}
      {%- else -%}
        {%- assign expression = chunk | split: '}}' | first | append: '}}' -%}
        #{{ chunk | remove_first: expression }}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {
    "title": {{ document.title | jsonify }},
    "url": {{ document.url | relative_url | jsonify }},
    "description": {{ document.description | jsonify }},
    "content": {{ searchable_content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
