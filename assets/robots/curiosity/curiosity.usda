#usda 1.0
(
    defaultPrim = "Curiosity"
    doc = "MarsLab-authored derivative articulated rover. NASA supplied visualization source meshes and cited mission evidence, not this URDF/USD or estimated link mass distribution."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Curiosity" (
    customData = {
        dictionary marslab = {
            string groundFrame = "X forward, Y left, Z up; ground midpoint of middle wheel axle"
            string modelAuthor = "MarsLab"
            string physicsFidelity = "estimated articulated rigid-body simulation model"
            string sourceAgency = "NASA"
            string sourceSha256 = "77fe6665223e38972728af404f1a277f0b0ab467fce5cc0aed6eba93488b74e2"
        }
    }
)
{
