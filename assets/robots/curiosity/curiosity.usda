            def Xform "Sensors"
            {
                def Camera "mahli"
                {
                    float2 clippingRange = (0.01, 200)
                    float focalLength = 20
                    float horizontalAperture = 11.572997
                    custom string marslab:dataStatus = "rendered_rgb_camera"
                    custom string marslab:fidelity = "Pinhole approximation. Orientation uses central ray of linear CAHV portion; CAHVOR/E radial/fisheye distortion and detector response are not reproduced. Full original coefficients retained below."
                    custom string marslab:naifFrame = "MSL_MAHLI"
                    custom bool marslab:physicalDepthSensor = 0
                    custom string marslab:poseFidelity = "Official CAHVOR camera pose refers to a different arm pose. Current mount is derived from NASA visualization MAHLI LED aperture geometry, not a flight-calibrated extrinsic."
                    custom string marslab:referencePose = "CAHVOR calibration arm reference pose; arm not stowed. Retarget via CAHVOR_POS/QUAT and arm kinematics before use on a different arm pose."
                    custom string marslab:resolution = "[1648, 1200]"
                    custom string marslab:sourceSha256 = "d319b396a210830e382021cb9494625d6e8e073fc40e56dab9e10241e4485682"
                    custom string marslab:sourceUrl = "https://naif.jpl.nasa.gov/pub/naif/MSL/kernels/ik/msl_mahli_20120731_c02.ti"
                    token projection = "perspective"
                    float verticalAperture = 8.434159
                    quatd xformOp:orient = (0.347910076379776, 0.04071026295423508, 0.7122758030891418, 0.6082470417022705)
                    double3 xformOp:translate = (-0.1222488367557526, -0.22623779495557148, 0.1464529285331566)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                }

                def Xform "Instruments"
                {
                    def Xform "apxs"
                    {
                        custom string marslab:dataStatus = "metadata_interface"
                        custom string marslab:specification = '{"components": ["apxs"], "id": "apxs", "name": "Alpha Particle X-ray Spectrometer", "proposed_simulation_mode": "metadata_interface", "source_url": "https://science.nasa.gov/mission/msl-curiosity/science-instruments/"}'

                        def Xform "apxs"
                        {
                            custom string marslab:dataStatus = "metadata_only_unsupported"
                            custom string marslab:locationFidelity = "No numerical pose claimed; semantic instrument interface."
                        }
                    }

                    def Xform "mahli"
                    {
                        custom string marslab:dataStatus = "rendered_camera"
                        custom rel marslab:mahli = </Curiosity/Body_Chassis/Body_ArmTurret/Sensors/mahli>
                        custom string marslab:specification = '{"components": ["mahli"], "id": "mahli", "name": "Mars Hand Lens Imager", "proposed_simulation_mode": "rendered_camera", "source_url": "https://science.nasa.gov/mission/msl-curiosity/science-instruments/"}'
                    }
                }
            }
