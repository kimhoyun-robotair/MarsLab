#usda 1.0
(
    defaultPrim = "LidarMount"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "LidarMount"
{
    def "Materials"
    {
        def Material "metal"
        {
            token outputs:surface.connect = </LidarMount/Materials/metal/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.38, 0.42, 0.46)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.46
                token outputs:surface
            }
        }

        def Material "white"
        {
            token outputs:surface.connect = </LidarMount/Materials/white/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.79, 0.75)
                float inputs:metallic = 0
                float inputs:roughness = 0.46
                token outputs:surface
            }
        }

        def Material "window"
        {
            token outputs:surface.connect = </LidarMount/Materials/window/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.012, 0.025, 0.032)
                float inputs:metallic = 0
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }

        def Material "bolt"
        {
            token outputs:surface.connect = </LidarMount/Materials/bolt/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.17, 0.1)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.46
                token outputs:surface
            }
        }
    }

