                dictionary marslab = {
                    string massSource = "MarsLab estimated subsystem partition, total constrained to NASA mission mass"
                }
            }
        )
        {
            point3f physics:centerOfMass = (0.101524465, 0.018145874, 0.6945022)
            float3 physics:diagonalInertia = (30.791403, 38.737736, 52.067528)
            float physics:mass = 158.8
            quatf physics:principalAxes = (0.67227626, -0.07259383, -0.07357577, 0.73304933)
            bool physics:rigidBodyEnabled = 1
            custom bool physxArticulation:enabledSelfCollisions = 0
            custom int physxArticulation:solverPositionIterationCount = 32
            custom int physxArticulation:solverVelocityIterationCount = 4
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def "visuals"
