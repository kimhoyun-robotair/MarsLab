                def Camera "microscopic_imager"
                {
                    float2 clippingRange = (0.01, 200)
                    float focalLength = 20.13
                    float horizontalAperture = 8.6602125
                    custom string marslab:dataStatus = "rendered_rgb_camera"
                    custom string marslab:fidelity = "Pinhole approximation with geometry-derived stowed mount. NASA intrinsics remain cited; physical entrance pupil, dust-cover transmission, close-focus microscope response, radial distortion and detector response are not reproduced."
                    custom string marslab:naifFrame = "MER-1_MICROIMAGER_F2"
                    custom bool marslab:physicalDepthSensor = 0
                    custom string marslab:referencePose = "Fixed stowed-arm visualization pose. MarsLab derives the virtual pinhole from the MI optics-box front face; original extended NASA calibration pose is retained in calibration_reference_pose. Not flight-calibrated stowed extrinsics."
                    custom string marslab:resolution = "[1024, 1024]"
                    custom string marslab:sourceSha256 = "65b149d4ba038980e08095e0c7d1a59e11a8a6a5ce26717c1d35d584a0522171"
