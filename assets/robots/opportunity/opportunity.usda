    def "Looks"
    {
        def Material "foil_silver"
        {
            token outputs:surface.connect = </Opportunity/Looks/foil_silver/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Silver"
