<?xml version="1.0" encoding="UTF-8"?>
<!-- Ingenuity-class rotorcraft for perception pipeline validation.
     Box body + 4 rotor disks. Phase 1: kinematic only, no flight dynamics.
     Mass: 1.8kg (Ingenuity actual mass). -->
<robot name="simple_rotorcraft">

  <!-- Body -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.3 0.3 0.15"/>
      </geometry>
      <material name="body_color">
        <color rgba="0.8 0.6 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.3 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.8"/>
      <inertia ixx="0.012" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.018"/>
    </inertial>
  </link>

  <!-- Rotor 1 (front-left) -->
  <link name="rotor_fl">
    <visual>
      <geometry><cylinder radius="0.3" length="0.01"/></geometry>
      <material name="rotor_color"><color rgba="0.2 0.2 0.2 0.5"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.3" length="0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0009"/>
    </inertial>
  </link>
  <joint name="joint_rotor_fl" type="fixed">
    <parent link="base_link"/>
    <child link="rotor_fl"/>
    <origin xyz="0.15 0.15 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Rotor 2 (front-right) -->
  <link name="rotor_fr">
    <visual>
      <geometry><cylinder radius="0.3" length="0.01"/></geometry>
      <material name="rotor_color"><color rgba="0.2 0.2 0.2 0.5"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.3" length="0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0009"/>
    </inertial>
  </link>
  <joint name="joint_rotor_fr" type="fixed">
    <parent link="base_link"/>
    <child link="rotor_fr"/>
    <origin xyz="0.15 -0.15 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Rotor 3 (rear-left) -->
  <link name="rotor_rl">
    <visual>
      <geometry><cylinder radius="0.3" length="0.01"/></geometry>
      <material name="rotor_color"><color rgba="0.2 0.2 0.2 0.5"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.3" length="0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0009"/>
    </inertial>
  </link>
  <joint name="joint_rotor_rl" type="fixed">
    <parent link="base_link"/>
    <child link="rotor_rl"/>
    <origin xyz="-0.15 0.15 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Rotor 4 (rear-right) -->
  <link name="rotor_rr">
    <visual>
      <geometry><cylinder radius="0.3" length="0.01"/></geometry>
      <material name="rotor_color"><color rgba="0.2 0.2 0.2 0.5"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.3" length="0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0009"/>
    </inertial>
  </link>
  <joint name="joint_rotor_rr" type="fixed">
    <parent link="base_link"/>
    <child link="rotor_rr"/>
    <origin xyz="-0.15 -0.15 0.1" rpy="0 0 0"/>
  </joint>

</robot>
