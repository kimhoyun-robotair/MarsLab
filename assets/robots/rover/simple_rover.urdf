<?xml version="1.0" encoding="UTF-8"?>
<!-- Simple 6-wheeled Mars rover for URDF→USD pipeline validation.
     Box chassis + 6 cylindrical wheels. No rocker-bogie (Week 14).
     Mass: base 50kg, each wheel 2kg. Total 62kg. -->
<robot name="simple_rover">

  <!-- Base link: box chassis -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="1.0 0.6 0.3"/>
      </geometry>
      <material name="chassis_color">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="1.0 0.6 0.3"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="50.0"/>
      <inertia ixx="1.95" ixy="0" ixz="0" iyy="2.33" iyz="0" izz="3.58"/>
    </inertial>
  </link>

  <!-- Wheel macro: 6 wheels (front/mid/rear, left/right) -->
  <!-- Front Left -->
  <link name="wheel_fl">
    <visual>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
      <material name="wheel_color"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.0056" ixy="0" ixz="0" iyy="0.0056" iyz="0" izz="0.0045"/>
    </inertial>
  </link>
  <joint name="joint_fl" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fl"/>
    <origin xyz="0.35 0.35 -0.15" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.5" friction="1.0"/>
  </joint>

  <!-- Front Right -->
  <link name="wheel_fr">
    <visual>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
      <material name="wheel_color"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.0056" ixy="0" ixz="0" iyy="0.0056" iyz="0" izz="0.0045"/>
    </inertial>
  </link>
  <joint name="joint_fr" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fr"/>
    <origin xyz="0.35 -0.35 -0.15" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.5" friction="1.0"/>
  </joint>

  <!-- Mid Left -->
  <link name="wheel_ml">
    <visual>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
      <material name="wheel_color"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.0056" ixy="0" ixz="0" iyy="0.0056" iyz="0" izz="0.0045"/>
    </inertial>
  </link>
  <joint name="joint_ml" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_ml"/>
    <origin xyz="0.0 0.35 -0.15" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.5" friction="1.0"/>
  </joint>

  <!-- Mid Right -->
  <link name="wheel_mr">
    <visual>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
      <material name="wheel_color"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.0056" ixy="0" ixz="0" iyy="0.0056" iyz="0" izz="0.0045"/>
    </inertial>
  </link>
  <joint name="joint_mr" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_mr"/>
    <origin xyz="0.0 -0.35 -0.15" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.5" friction="1.0"/>
  </joint>

  <!-- Rear Left -->
  <link name="wheel_rl">
    <visual>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
      <material name="wheel_color"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.0056" ixy="0" ixz="0" iyy="0.0056" iyz="0" izz="0.0045"/>
    </inertial>
  </link>
  <joint name="joint_rl" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rl"/>
    <origin xyz="-0.35 0.35 -0.15" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.5" friction="1.0"/>
  </joint>

  <!-- Rear Right -->
  <link name="wheel_rr">
    <visual>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
      <material name="wheel_color"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.0056" ixy="0" ixz="0" iyy="0.0056" iyz="0" izz="0.0045"/>
    </inertial>
  </link>
  <joint name="joint_rr" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rr"/>
    <origin xyz="-0.35 -0.35 -0.15" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.5" friction="1.0"/>
  </joint>

</robot>
