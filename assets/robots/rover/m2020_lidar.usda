#usda 1.0
(
    defaultPrim = "Perseverance"
    metersPerUnit = 1
    subLayers = [
        @m2020.usd@
    ]
    upAxis = "Z"
)

over "Perseverance"
{
    over "Body_Chassis"
    {
        over "Body_Chassis" (
            prepend apiSchemas = ["PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (-0.05615486, -0.057124846, 1.1486355)
            float3 physics:diagonalInertia = (155.9131, 410.05435, 463.61334)
            float physics:mass = 675.6882
            quatf physics:principalAxes = (0.9898891, -0.13549902, 0.04194739, -0.00029115428)

            def "LidarMounts"
            {
                def Xform "lidar_2d" (
                    prepend references = @../sensors/lidar_2d.usda@
                )
                {
                    double3 xformOp:translate = (0.9, 0.25, 1.4)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                }

                def Xform "lidar_3d" (
                    prepend references = @../sensors/lidar_3d.usda@
                )
                {
                    double3 xformOp:translate = (0.45, 0.25, 2.2)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                }
            }
        }
    }
}

