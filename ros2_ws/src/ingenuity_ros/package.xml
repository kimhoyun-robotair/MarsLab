<?xml version="1.0"?>
<package format="3">
  <name>ingenuity_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 Jazzy command and telemetry adapters for MarsLab ArduPilot SITL.</description>
  <maintainer email="maintainer@example.invalid">Package maintainer</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pymavlink</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
